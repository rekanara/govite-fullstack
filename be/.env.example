APP_ENV=development
APP_PORT=3000
# Used to build links in emails (reset password, invite, verify email).
WEB_URL=http://localhost:5173
# Only needed when the web app is on another origin (no Vite proxy). Comma-separated.
CORS_ORIGIN=
# Behind a reverse proxy, trust X-Forwarded-For for client IPs and rate limits.
TRUST_PROXY=false

DATABASE_URL=postgres://app:app@localhost:5434/app?sslmode=disable
# Empty = in-memory rate limits and no permission cache (fine for one instance).
REDIS_URL=redis://localhost:6380/0

JWT_ACCESS_SECRET=change-me-32-bytes-minimum-secret-value
REFRESH_TOKEN_PEPPER=change-me-refresh-pepper

SUPER_ADMIN_EMAIL=admin@app.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Mailpit in dev: UI http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@app.local

THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=10
LOG_LEVEL=info

# MinIO console http://localhost:9101. Empty keys disable uploads (503).
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=app
MINIO_USE_SSL=false
# Browser-facing address when it differs from MINIO_ENDPOINT (reverse proxy / CDN host).
MINIO_PUBLIC_ENDPOINT=
STORAGE_PUBLIC_URL=

# Push (FCM): path to a Firebase service-account JSON. Empty disables push.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Payment webhooks: empty server key disables /webhooks/midtrans.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
WEBHOOK_THROTTLE_LIMIT=300

# Sentry: empty DSN disables error tracking.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
